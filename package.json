{
  "name": "lacinka-electron",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "build:transform": "launcher\\build-transform-cli.bat",
    "start": "node electron-start.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "dev.lacinka.app",
    "productName": "Lacinka",
    "artifactName": "Lacinka.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "core/common/Common.js",
      "frontend/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "transform_cli.exe",
        "to": "transform_cli.exe"
      }
    ],
    "win": {
      "icon": "assets/icons/lacinka.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12"
  }
}
